ort)\"/>\n    <path d=\"M1160 545 H1280\" stroke=\"#f59e0b\" marker-end=\"url(#a-turn)\"/>\n    <path d=\"M1280 600 H1160\" stroke=\"#c084fc\" marker-end=\"url(#a-model)\"/>\n    <path d=\"M1860 545 H1980\" stroke=\"#94a3b8\" stroke-dasharray=\"8 7\" marker-end=\"url(#a-support)\"/>\n    <path d=\"M1838 760 C1910 780 1940 800 1980 820\" stroke=\"#94a3b8\" stroke-dasharray=\"8 7\" marker-end=\"url(#a-support)\"/>\n    <path d=\"M2340 815 C2380 800 2410 800 2460 800\" stroke=\"#c084fc\" marker-end=\"url(#a-model)\"/>\n    <path d=\"M2460 860 C2410 880 2380 880 2340 870\" stroke=\"#c084fc\" marker-end=\"url(#a-model)\"/>\n    <path d=\"M420 960 C650 1040 970 1040 1128 1080\" stroke=\"#34d399\" marker-end=\"url(#a-tool)\"/>\n    <path d=\"M1128 1285 C880 1370 650 1330 540 1285\" stroke=\"#34d399\" marker-end=\"url(#a-tool)\"/>\n    <path d=\"M900 960 C820 1020 620 1040 470 1080\" stroke=\"#34d399\" marker-end=\"url(#a-tool)\"/>\n    <path d=\"M640 1240 C1000 1330 1700 1340 2180 1230\" stroke=\"#34d399\" marker-end=\"url(#a-tool)\"/>\n    <path d=\"M640 1160 H656\" stroke=\"#94a3b8\" stroke-dasharray=\"8 7\" marker-end=\"url(#a-support)\"/>\n    <path d=\"M812 688 C1180 350 2050 320 2450 315\" stroke=\"#94a3b8\" stroke-dasharray=\"8 7\" marker-end=\"url(#a-support)\"/>\n  </g>\n\n  <g font-size=\"14\" font-weight=\"700\">\n    <circle cx=\"145\" cy=\"168\" r=\"15\" fill=\"#0b1120\" stroke=\"#f59e0b\" stroke-width=\"3\"/><text x=\"145\" y=\"173\" text-anchor=\"middle\" fill=\"#fbbf24\">1</text>\n    <text x=\"1250\" y=\"365\" fill=\"#67e8f9\">2 \u00b7 Op::TurnInput</text>\n    <text x=\"1210\" y=\"528\" fill=\"#fbbf24\">3 \u00b7 Prompt + history + tools</text>\n    <text x=\"1220\" y=\"583\" fill=\"#d8b4fe\">4 \u00b7 ResponseEvent stream</text>\n    <text x=\"520\" y=\"1018\" fill=\"#86efac\">5 \u00b7 FunctionCall</text>\n    <text x=\"790\" y=\"1370\" fill=\"#86efac\">6 \u00b7 Tool result \u2192 next model request</text>\n    <text x=\"1470\" y=\"390\" fill=\"#67e8f9\">7